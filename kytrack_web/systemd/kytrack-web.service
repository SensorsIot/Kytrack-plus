[Unit]
Description=kytrack browser map backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/kytrack-web
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kytrack-web/.venv/bin/python -m kytrack_web.app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
